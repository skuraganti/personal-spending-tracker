# All data stay in this project. Source currency is an explicit GBP assumption.
LEDGER_PORT=8280
# Native path only; Docker uses its independent named volume at /state.
MONEYVIS_DB=data/app.db
MONEYVIS_MAX_IMPORT_BYTES=1000000
MONEYVIS_MAX_IMPORT_ROWS=50000
MONEYVIS_MAX_DIAGNOSTICS=50
MONEYVIS_CURRENCY=GBP
